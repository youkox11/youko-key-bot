# Copy this file to ".env" (copy .env.example .env) and fill in your values.
# Do NOT use quotes or spaces around "=". Never commit the real .env file.

# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Webhook mode (Render). Leave WEBHOOK_BASE_URL empty locally to use long polling.
# On Render, RENDER_EXTERNAL_URL is provided automatically.
WEBHOOK_BASE_URL=
# Required only in webhook mode: 16-256 chars, letters/digits/_/- only
WEBHOOK_SECRET=

# Optional: an authorized HTTPS key API you are permitted to use (see README).
# Leave both empty to run without key retrieval.
AUTHORIZED_API_URL=
AUTHORIZED_API_TOKEN=

# Optional tuning
RATE_LIMIT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=15
JOB_TIMEOUT_SECONDS=90
POLL_INTERVAL_SECONDS=3
LOG_LEVEL=INFO
